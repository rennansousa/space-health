  "pdfRegexExtractors": [
    {
      "analyte": "IRON_SERUM",
      "displayName": "Serum iron",
      "patterns": [
        "(?:ferro\\s*(?:s[eé]rico|total)?|serum\\s*iron|iron\\b)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "µg/dL",
      "units": {
        "ug/dl": 1,
        "umol/l": 5.587
      },
      "plausible": [
        5,
        1000
      ]
    },
    {
      "analyte": "FERRITIN",
      "displayName": "Ferritin",
      "patterns": [
        "(?:ferritina|ferritin)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "ng/mL",
      "units": {
        "ng/ml": 1,
        "ug/l": 1
      },
      "plausible": [
        1,
        50000
      ]
    },
    {
      "analyte": "HEMOGLOBIN",
      "displayName": "Hemoglobin",
      "patterns": [
        "(?:hemoglobina|hemoglobin|\\bhgb\\b|\\bhb\\b)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "g/dL",
      "units": {
        "g/dl": 1,
        "g/l": 0.1
      },
      "plausible": [
        3,
        25
      ]
    },
    {
      "analyte": "VITAMIN_D",
      "displayName": "Vitamin D",
      "patterns": [
        "(?:vitamina\\s*d|vitamin\\s*d|25[-\\s]?oh[-\\s]?d)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "ng/mL",
      "units": {
        "ng/ml": 1,
        "nmol/l": 0.4
      },
      "plausible": [
        1,
        250
      ]
    },
    {
      "analyte": "GLUCOSE",
      "displayName": "Glucose",
      "patterns": [
        "(?:glicemia|glicose|glucose)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "mg/dL",
      "units": {
        "mg/dl": 1,
        "mmol/l": 18.0
      },
      "plausible": [
        10,
        1500
      ]
    },
    {
      "analyte": "POTASSIUM",
      "displayName": "Potassium",
      "patterns": [
        "(?:pot[aá]ssio|potassium|\\bk\\+\\b)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "mmol/L",
      "units": {
        "mmol/l": 1,
        "meq/l": 1
      },
      "plausible": [
        1,
        10
      ]
    },
    {
      "analyte": "SODIUM",
      "displayName": "Sodium",
      "patterns": [
        "(?:s[oó]dio|sodium|\\bna\\+\\b)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "mmol/L",
      "units": {
        "mmol/l": 1,
        "meq/l": 1
      },
      "plausible": [
        90,
        200
      ]
    },
    {
      "analyte": "CHLORIDE",
      "displayName": "Chloride",
      "patterns": [
        "(?:cloreto|chloride|\\bcl-?)(?:\\s*\\([^)\\n]{1,20}\\))?\\s*[:\\-=]?\\s*([0-9]+(?:[.,][0-9]+)?)"
      ],
      "defaultUnit": "mmol/L",
      "units": {
        "mmol/l": 1,
        "meq/l": 1
      },
      "plausible": [
        50,
        160
      ]
    },
    {
      "analyte": "CARBON_DIOXIDE",
      "displayName": "Bicarbonate (total CO2)",
