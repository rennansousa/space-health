  "adapters": {
    "HRF_RIC_BUS": {
      "enabled": true,
      "label": "Rack-style medical bus adapter (simulated; no public HRF data feed)",
      "transport": "ISS HRF PC / Ethernet + RS-422 + MIL-STD-1553",
      "category": "HARDWARE_RACK",
      "priority": 1,
      "requiresAuth": true,
      "description": "Simulated adapter in the style of a medical rack bus. Translates key names to the canonical record. There is no public data feed from the ISS Human Research Facility.",
      "defaultMappings": {
        "HR_BPM": "heartRateBpm",
        "SPO2": "spo2Pct",
        "SYS_BP": "systolicMmHg",
        "PCO2_MMHG": "co2MmHg",
        "RAD_MSV": "radiationMsVPerDay",
        "OCT_UM": "trtMicrons"
      },
      "status": "SIMULATED",
      "simulated": true
    },
    "PDF_EXAM": {
      "enabled": true,
      "label": "Lab report: PDF or pasted text",
      "transport": "Offline Local File / Store-and-Forward Upload",
      "category": "DOCUMENT_OCR_REGEX",
      "priority": 2,
      "requiresAuth": true,
      "description": "Extracts blood chemistry, hemoglobin, iron, ferritin, vitamin D, glucose, potassium, BUN, AST, and ALT from PDF streams or plain clinical text using deterministic Regex rules.",
      "status": "ACTIVE",
      "simulated": false
    },
    "OSD575_CSV_EXCEL": {
      "enabled": true,
      "label": "Lab analyzer export: CSV in the NASA OSDR OSD-575 format",
      "transport": "Offline Pre-Flight / Post-Flight Batch CSV",
      "category": "SCIENTIFIC_DATASET",
      "priority": 3,
      "requiresAuth": true,
      "description": "Ingests NASA OSDR LSDS-8 Comprehensive Metabolic Panel CSV rows (ANALYTE, VALUE, RANGE_MIN, RANGE_MAX, UNITS, SUBJECT_ID, timepoint).",
      "status": "ACTIVE",
      "simulated": false
    },
    "BLE_SUIT": {
      "enabled": true,
      "label": "Suit vitals over Bluetooth (simulated frames)",
      "transport": "BLE GATT Service",
      "category": "WEARABLE_CONTINUOUS",
      "priority": 4,
      "requiresAuth": true,
      "description": "Handles hexadecimal or key-value EVA suit telemetry packets (HR in hex or bpm, SpO2, skin temperature in F or C, respiratory rate).",
      "status": "SIMULATED",
      "simulated": true
    },
    "LAN_CABIN": {
      "enabled": true,
      "label": "Cabin environment over the habitat network (simulated)",
      "transport": "CCSDS / TCP-UDP Local Mesh",
      "category": "HABITAT_ENVIRONMENT",
      "priority": 5,
      "requiresAuth": true,
      "description": "Ingests ambient CO2 pockets (ppm or mmHg), cabin pressure (kPa or mmHg), O2 %, and CANS cosmic radiation (mSv/day).",
      "status": "SIMULATED",
      "simulated": true
    },
    "DEVICE_JSON": {
      "enabled": true,
      "label": "Any device or machine over HTTP: JSON readings (Arduino, ESP32, script, analyzer)",
      "transport": "HTTP POST /api/v1/ingest with a device key",
      "category": "GENERIC_DEVICE",
      "priority": 6,
      "requiresAuth": true,
      "description": "One JSON body with a list of readings {type, value, unit}. Types come from vitalsCatalog. The device key decides which crew member the readings belong to.",
      "status": "ACTIVE",
      "simulated": false
    },
    "VOICE_NOTOUCH": {
      "enabled": false,
      "label": "Voice symptom log (future adapter, not implemented; spoken questions to the assistant already work in the browser)",
