{
  "schemaVersion": "SH-CANONICAL-1",
  "description": "Space Health input switch: one declarative file that lists every data source, the analyte catalog, lab reference ranges, exam-text extractors and the rule parameters. Adding a device means adding a block here, not changing the engine.",
  "nasaDataSources": {
    "osd575BloodCsv": {
      "path": "backend/data/osd_575_real_astronaut_blood.csv",
      "dataset": "NASA Open Science Data Repository OSD-575, SpaceX Inspiration4 comprehensive metabolic panel",
      "url": "https://osdr.nasa.gov/bio/repo/data/studies/OSD-575",
      "note": "Real data. Four crew members (C001-C004), 19 analytes, 7 draws from L-92 to R+194. Pre-flight draws are used as the personal baseline.",
      "downloadUrl": "https://osdr.nasa.gov/geode-py/ws/studies/OSD-575/download?source=datamanager&file=LSDS-8_Comprehensive_Metabolic_Panel_CMP.upload_SUBMITTED.csv",
      "downloadDate": "2026-11-15",
      "sha256": "dab247eb794edab59aaaa683c85fd1f2dbf4ae3684872739338e10ead4192a0c"
    }
  },
  "rules": {
    "baseline": {
      "outOfRangeTolerancePct": 10,
      "inRangeShiftPct": 25,
      "minPoints": 2,
      "_note": "outOfRangeTolerancePct is the default band around the personal baseline; tightly regulated analytes override it with analyteCatalog.personalTolerancePct. Example values, to be set by the flight surgeon."
    },
    "artifact": {
      "minCrew": 3,
      "minFraction": 0.5
    },
    "triage": {
      "rateWeight": 3.5,
      "amberUrgency": 20
    },
    "redFlags": {
      "_note": "Example limits for the demo, not clinically validated. To be set by the flight surgeon.",
      "GLUCOSE": {
        "below": 54,
        "above": 400,
        "unit": "mg/dL"
      },
      "POTASSIUM": {
        "below": 3.0,
        "above": 6.0,
        "unit": "mmol/L"
      },
      "SODIUM": {
        "below": 125,
        "above": 155,
        "unit": "mmol/L"
      },
      "CALCIUM": {
        "below": 7.0,
        "above": 12.0,
        "unit": "mg/dL"
      }
    },
    "missionDayOffsetAfterReturn": 3,
    "trend": {
      "minPoints": 3,
      "horizonDays": 30,
      "minRSquared": 0.6,
      "_note": "Watch list only: a straight line through in-mission draws (missionDay >= 0). It never changes the risk tier. Example values, to be set by the flight surgeon."
    },
    "news2": {
      "source": {
        "title": "Royal College of Physicians. National Early Warning Score (NEWS) 2, Chart 1 and Chart 2 (2017)",
        "url": "https://www.rcp.ac.uk/resources/national-early-warning-score-news-2/"
      },
      "_note": "Bands are [upper limit inclusive, score], ascending; null means 'anything higher'. NEWS2 was validated in hospitals on Earth, not in microgravity. Consciousness and supplemental oxygen are not measured by these devices, so the score is partial.",
      "mediumAt": 5,
      "highAt": 7,
      "maxAgeMinutes": 360,
      "bands": {
        "RESP_RATE": [
          [
            8,
            3
          ],
          [
            11,
            1
          ],
          [
            20,
            0
          ],
          [
            24,
            2
          ],
          [
