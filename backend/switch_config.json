      "category": "NEURO_COGNITIVE",
      "priority": 7,
      "requiresAuth": true,
      "description": "Future adapter. Listed to show how a new device plugs in; no implementation, no data.",
      "status": "FUTURE",
      "simulated": true
    },
    "FACIAL_FACS_CV": {
      "enabled": false,
      "label": "Camera-based vitals (future adapter, not implemented; no emotion inference)",
      "transport": "Onboard Local Camera (Zero-PII Edge)",
      "category": "AFFECTIVE_COMPUTING",
      "priority": 8,
      "requiresAuth": true,
      "privacyGuardrail": "Raw negative emotion labels (sadness, fear, anxiety) are routed strictly to GROUND_MANAGER and masked with supportive coaching on ASTRONAUT UI.",
